hello world


global _start

section .data
    msg db "Hello World", 10
    len equ $ - msg

section .text

_start:

    ; write(1, msg, len)

    mov rax, 1
    mov rdi, 1
    mov rsi, msg
    mov rdx, len
    syscall

    ; exit(0)

    mov rax, 60
    xor rdi, rdi
    syscall



-
nasm -f elf64 hello.asm -o hello.o
ld hello.o -o hello

./hello

